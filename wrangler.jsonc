{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "cdb66944-5f17-46e5-86f7-f3d519bee5cb","database_name": "jarvis" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "56a62d6a72ec47bf83c10a5524d7bda0" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
